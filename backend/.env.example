# --- Base de données MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medishield

# --- JWT ---
JWT_SECRET=change-moi-en-une-longue-chaine-aleatoire
JWT_EXPIRATION=8h

# --- Inscription ---
# Code à communiquer en interne à tout nouvel administrateur qui
# doit créer son compte via la page /inscription.
CODE_INSCRIPTION=change-moi-code-secret

# --- OTP ---
OTP_DUREE_SECONDES=300

# --- Email (SMTP) pour l'envoi d'OTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton-compte@gmail.com
SMTP_PASSWORD=mot-de-passe-application

# --- Port du serveur ---
PORT=4000
